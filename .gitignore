# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# relatório de cobertura dos testes (gerado por npm run test:coverage).
# O Prettier 3 também respeita o .gitignore, então o format:check deixa de olhar esta pasta
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Claude Code (permissões e config local — não versionar)
.claude/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
